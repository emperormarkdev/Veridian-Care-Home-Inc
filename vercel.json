{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.veridiancarehome.inc" }],
      "destination": "https://veridiancarehome.inc/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/mission", "destination": "/index.html" },
    { "source": "/vision", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" }
  ]
}
